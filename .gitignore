# C++
**/cmake-build*/
**/build*/
**/*.so
**/*.log*

# Omniverse
**/*.dmp
**/.thumbs

# No USD files allowed in the repo
**/*.usd
**/*.usda
**/*.usdc
**/*.usdz

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb

# Docker/Singularity
**/*.sif
docker/cluster/exports/
docker/.container.cfg

# IDE
**/.idea/
**/.vscode/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!.vscode

# Outputs
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp

# Doc Outputs
**/docs/_build/*
**/generated/*

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

# RL-Games
**/runs/*
**/logs/*
**/recordings/*

# Pre-Trained Checkpoints
/.pretrained_checkpoints/

# Teleop Recorded Dataset
/datasets/

# Tests
tests/

# Docker history
.isaac-lab-docker-history

# ---- Action Space project ----
# training checkpoints, cloud/laptop scratch, generated data (all reproducible with the scripts)
logs/
media/yolo/
media/yolo_dataset/
media/synthetic/
media/models/
media/replay/*.json
media/replay/*.html
!media/replay/replay3d_arena_gate.html
# keep the vision-pipeline videos (the generic rule above ignores **/videos/*)
!media/videos/
!media/videos/*.mp4
!media/videos/*.json
config/realsense_extrinsics.json

# pretrained weights downloaded by ultralytics
*.pt
weights/
*.pth

# Camera recordings from the Tello test panel
recordings/

# web replay fragment built for hosting (scripts/build_web_replay.py); the standalone copy is docs/web/Action_Space_3D_Replay.html
docs/web/action_space_3d.html
